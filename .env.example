# ---- SERP source (required: this is how pages get discovered) ----
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional self-hosted SERP service speaking the same shape. Leave blank to use DataForSEO.
SERP_API_URL=
SERP_API_KEY=

# ---- LLM (optional) ----
# Any OpenAI-compatible chat-completions endpoint. OpenRouter is the easiest start:
#   LLM_API_URL=https://openrouter.ai/api/v1
# Without this, run with --no-funnel --no-entities --no-topical for a deterministic report.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Optional extras. Every one of these degrades gracefully when blank. ----
# Free from Google: https://developers.google.com/web/tools/chrome-user-experience-report/api
CRUX_API_KEY=

# Better semantic factors than the TF-IDF fallback.
EMBEDDINGS_API_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# Fetch escalation for pages that block plain HTTP.
ZYTE_API_KEY=

# Backlink + brand panels. JSON array of Semrush-compatible endpoints:
#   [{"base":"https://...","key":"..."}]
# No provider is bundled; blank skips both panels.
BACKLINK_API_ENDPOINTS=

# Domain authority + traffic. Speaks POST /v1/batch-check. Blank skips the panel.
AUTHORITY_API_URL=
AUTHORITY_API_KEY=

# ---- Storage ----
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=ranklens
POSTGRES_DB=ranklens
POSTGRES_PASSWORD=CHANGEME

# ---- Auth ----
# WARNING: blank means write endpoints are OPEN to anyone who can reach the port.
RANKLENS_API_KEY=
RANKLENS_ALLOW_SIGNUP=false
RANKLENS_SESSION_DAYS=30
